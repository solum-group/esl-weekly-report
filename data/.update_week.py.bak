existing_urls = set()
def collect_urls(sections):
    for k, v in sections.items():
        if isinstance(v, dict):
            for seg, arr in v.items():
                for a in arr:
                    existing_urls.add(a.get("sourceUrl"))
        else:
            for a in v:
                existing_urls.add(a.get("sourceUrl"))
collect_urls(d["sections"])

added = 0
for sec, arts in new_articles.items():
    for a in arts:
        if a["sourceUrl"] in existing_urls:
            print("SKIP dup:", a["sourceUrl"])
            continue
        d["sections"][sec].append(a)
        added += 1

addendum = (
