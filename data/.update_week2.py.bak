    "SOLUM 뉴스룸은 동적 로딩으로 목록 미노출, E Ink 블로그·Vusion·Hanshow·Pricer·ZKONG·Digitimes·The Grocer(405)·Progressive Grocer는 "
    "범위 내 ESL 신규 없음 확인."
)
d["searchAnalysis"] = d["searchAnalysis"] + addendum

with open(path, "w", encoding="utf-8") as f:
    json.dump(d, f, ensure_ascii=False, indent=2)
    f.write("\n")

print("Added:", added)

def count_total(sections):
    total = 0
    for k, v in sections.items():
        if isinstance(v, dict):
            total += sum(len(vv) for vv in v.values())
        else:
            total += len(v)
    return total

print("New total articles:", count_total(d["sections"]))
